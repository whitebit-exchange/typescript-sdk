{
  "compilerOptions": {
    "outDir": "./dist/esm",
    "rootDir": ".",
    "module": "ESNext",
    "target": "ES2020",
    "declaration": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "moduleResolution": "node",
    "types": [
      "node"
    ]
  },
  "include": [
    "*.ts",
    "api/**/*.ts",
    "auth/**/*.ts",
    "core/**/*.ts",
    "errors/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}